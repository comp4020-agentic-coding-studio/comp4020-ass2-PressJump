---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { navGroups, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// What this person teaches is derived from the lecture and session pages that
// name them, never from a list typed into the profile. Those prose lines said
// "I teach weeks 1, 5, 6, 11 and 12" and they are gone: a teaching load typed
// in two places is a teaching load that disagrees with itself by week 3.
const [lectures, sessions] = await Promise.all([
  getPublishedCollection("lectures"),
  getPublishedCollection("sessions"),
]);
const taughtBy = <T extends { data: { teachers?: { id: string }[]; week: number } }>(
  entries: T[],
): T[] =>
  entries
    .filter((entry) => (entry.data.teachers ?? []).some((ref) => ref.id === person.id))
    .sort((a, b) => a.data.week - b.data.week);

const teachesLectures = taughtBy(lectures);
const teachesSessions = taughtBy(sessions);

const data = person.data;
// photoAlt and the profile fields ride the schema; narrow at the boundary.
const rawPhotoAlt = (data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";

// The role is free text in the schema, so it renders as written. The starter
// mapped it through a convenor|tutor|guest|other lookup, which meant every
// role on this site ("Lecturer", "Field session tutor") resolved to undefined
// and the row never appeared at all.
const roleLabel = data.role;

const facts: { label: string; value: unknown; href?: string }[] = [
  { label: "Role", value: roleLabel },
  { label: "Affiliation", value: data.affiliation },
  { label: "Office", value: data.office },
  { label: "Phone", value: data.phone, href: data.phone ? `tel:${String(data.phone).replace(/\s/g, "")}` : undefined },
  { label: "Email", value: data.email, href: data.email ? `mailto:${data.email}` : undefined },
  { label: "Consultation", value: data.consultation },
  { label: "At Slop since", value: data.joined },
];
import NavGroups from "../../components/NavGroups.astro";
---

{/* The portrait is not the hero. The hero crops to a wide letterbox and a
    square headshot cropped that far is a band across somebody's eyes, which is
    a worse picture of a person than no picture at all. Here it sits beside the
    facts at the size a staff page actually wants. */}
<ContentLayout
  title={person.data.title}
  description={person.data.description}
  {...siteConfig}
>
  <div class="profile">
    {person.data.photo && (
      <Image
        class="portrait"
        src={person.data.photo}
        alt={photoAlt}
        width={440}
        height={440}
        format="avif"
        loading="eager"
      />
    )}
    <dl class="facts">
    {
      facts
        .filter((fact) => fact.value)
        .map((fact) => (
          <>
            <dt>{fact.label}</dt>
            <dd>
              {fact.href ? <a href={fact.href}>{String(fact.value)}</a> : String(fact.value)}
            </dd>
          </>
        ))
    }
    {
      data.profiles && data.profiles.length > 0 && (
        <>
          <dt>Elsewhere</dt>
          <dd>
            <ul class="inline">
              {data.profiles.map((profile) => (
                <li>
                  <a href={profile.href}>{profile.label}</a>
                </li>
              ))}
            </ul>
          </dd>
        </>
      )
    }
    </dl>
  </div>

  {data.contact && <p class="contact-note">{data.contact}</p>}

  <Content />

  {
    (teachesLectures.length > 0 || teachesSessions.length > 0) && (
      <>
        <h2>Teaching this semester</h2>
        {teachesLectures.length > 0 && (
          <>
            <h3>Lectures</h3>
            <ul class="teaching">
              {teachesLectures.map((lecture) => (
                <li>
                  <a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a>
                  <span class="week">Week {lecture.data.week}</span>
                </li>
              ))}
            </ul>
          </>
        )}
        {teachesSessions.length > 0 && (
          <>
            <h3>{sessionLabels.plural}</h3>
            <ul class="teaching">
              {teachesSessions.map((session) => (
                <li>
                  <a href={withBase(`/sessions/${session.id}/`)}>{session.data.title}</a>
                  <span class="week">Week {session.data.week}</span>
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    )
  }

  {
    data.interests && data.interests.length > 0 && (
      <>
        <h2>Interests</h2>
        <ul class="tags">
          {data.interests.map((interest) => (
            <li>{interest}</li>
          ))}
        </ul>
      </>
    )
  }

  {
    data.publications && data.publications.length > 0 && (
      <>
        <h2>Selected publications</h2>
        <ul class="listing">
          {data.publications.map((paper) => (
            <li>
              <span class="year">{paper.year}</span>
              <span>
                {paper.title}. <em>{paper.venue}</em>.
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    data.awards && data.awards.length > 0 && (
      <>
        <h2>Awards</h2>
        <ul class="listing">
          {data.awards.map((award) => (
            <li>
              <span class="year">{award.year}</span>
              <span>
                {award.title}
                {award.body && <>. {award.body}.</>}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <NavGroups groups={navGroups} />
</ContentLayout>

<style>
  .profile {
    display: grid;
    grid-template-columns: 13.75rem 1fr;
    gap: 1.75rem;
    align-items: start;
    margin-block-end: 1.5rem;
  }

  .portrait {
    width: 100%;
    height: auto;
    border: 1px solid var(--at-border);
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(7rem, auto) 1fr;
    gap: 0.35rem 1.25rem;
    margin: 0;
  }

  .facts dt {
    font-weight: 600;
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  .facts dd {
    margin: 0;
  }

  .contact-note {
    padding: 0.8rem 1rem;
    border: 1px solid var(--at-border);
    background: var(--at-bg-alt);
    font-size: 0.95rem;
  }

  ul.inline,
  ul.teaching,
  ul.tags,
  ul.listing {
    list-style: none;
    padding: 0;
  }

  ul.inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
  }

  ul.teaching li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    padding-block: 0.4rem;
    border-block-end: 1px solid var(--at-border);
  }

  .week {
    color: var(--at-text-secondary);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  ul.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  ul.tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  ul.listing li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0.75rem;
    padding-block: 0.5rem;
    border-block-end: 1px solid var(--at-border);
  }

  .year {
    color: var(--at-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  @media (width < 44rem) {
    .profile {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .portrait {
      max-width: 11rem;
    }

    .facts {
      grid-template-columns: 1fr;
      gap: 0 0;
    }

    .facts dd {
      margin-block-end: 0.6rem;
    }

    ul.listing li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
