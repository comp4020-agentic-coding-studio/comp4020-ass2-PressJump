---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../../assets/images/hero-street-queue.avif";
import { withBase } from "astro-theme-university/url";
import { getPublishedCollection } from "astro-course-university/content";
import { lastActivity, lastPost, postDate, posterLookup } from "../../lib/forum";
import ForumCompose from "../../components/ForumCompose.astro";
import { navGroups, siteConfig } from "../../site-config";

const [threads, lectures, poster] = await Promise.all([
  getPublishedCollection("forum"),
  getPublishedCollection("lectures"),
  posterLookup(),
]);

// Read off the course record rather than typed here, so the week field on the
// compose form cannot outlive a change to how long the course runs.
const teachingWeeks = Math.max(...lectures.map((lecture) => lecture.data.week));

// One list, pinned at the top, then whatever moved most recently. Split into a
// "Pinned" section and a "Discussion" section it read as a notice board with a
// comments box rather than as a forum; a forum is one index where the pinned
// rows happen to be stuck to the top.
const sorted = [...threads].sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return lastActivity(b).getTime() - lastActivity(a).getTime();
});

const rows = sorted.map((thread) => ({
  thread,
  started: poster(thread.data),
  latest: lastPost(thread),
  answered: thread.data.replies.some((reply) => reply.answer),
}));

const categories = [...new Set(threads.map((thread) => thread.data.category))].sort();
import NavGroups from "../../components/NavGroups.astro";
---

<ContentLayout
  title="Forum"
  description={null}
  heroImage={heroImage}
  heroImageAlt="A street in gold and black, a queue of people with backpacks waiting behind a rope barrier along a shopfront under trees, with the road and pavement empty away to the left"
  {...siteConfig}
>
  <meta
    slot="head"
    name="description"
    content="The SLOP3068 course forum. Announcements, fieldwork problems and the arithmetic questions everybody turns out to have."
  />

  <ForumCompose categories={categories} weeks={teachingWeeks} />

  <div class="board">
    <div class="head" aria-hidden="true">
      <span>Topic</span>
      <span class="num">Replies</span>
      <span class="num">Views</span>
      <span>Last reply</span>
    </div>

    <ul class="threads" data-threads>
      {
        rows.map(({ thread, started, latest, answered }) => {
          const latestWho = poster(latest);
          return (
            <li
              class:list={["thread", { "thread--pinned": thread.data.pinned }]}
              data-thread
              data-category={thread.data.category}
            >
              <div class="topic">
                <p class="flags">
                  {thread.data.pinned && (
                    <>
                      <span class="pin" aria-hidden="true">
                        &#9733;
                      </span>
                      <span class="visually-hidden">Pinned.</span>
                    </>
                  )}
                  <span
                    class:list={[
                      "tag",
                      { "tag--announcement": thread.data.category === "Announcements" },
                    ]}
                  >
                    {thread.data.category}
                  </span>
                  {answered && <span class="tag tag--answered">Answered</span>}
                  {thread.data.locked && <span class="tag">Locked</span>}
                </p>
                <h2>
                  <a href={withBase(`/forum/${thread.id}/`)}>{thread.data.title}</a>
                </h2>
                <p class="excerpt">{thread.data.description}</p>
                <p class="started">
                  Started by {started.name}
                  {started.role && <span class="badge">{started.role}</span>}
                  <span class="sep">&middot;</span> week {thread.data.week}
                </p>
              </div>

              <p class="num">
                <span class="figure">{thread.data.replies.length}</span>{" "}
                <span class="unit">
                  {thread.data.replies.length === 1 ? "reply" : "replies"}
                </span>
              </p>

              <p class="num">
                <span class="figure">{thread.data.views}</span>{" "}
                <span class="unit">views</span>
              </p>

              <p class="latest">
                <span class="visually-hidden">Last reply </span>
                <span class="when">{postDate.format(latest.date)}</span>{" "}
                <span class="who">by {latestWho.name}</span>
              </p>
            </li>
          );
        })
      }
    </ul>

    {/* The shape a topic you start takes. Rendered here rather than assembled
        in the script, because Astro scopes these styles with a
        `data-astro-cid` attribute and an element built with createElement
        never gets one: the row lands on the board completely unstyled, which
        is exactly what it did the first time. Cloning a server-rendered
        template carries the scope with it. */}
    <template data-thread-template>
      <li class="thread thread--yours" data-thread>
        <div class="topic">
          <p class="flags">
            <span class="tag" data-slot="category"></span>
            <span class="tag tag--yours">Yours</span>
          </p>
          <h2 data-slot="title"></h2>
          <p class="excerpt" data-slot="body"></p>
          <p class="started">
            <span data-slot="started"></span>
            <span class="sep">&middot;</span>
            <span data-slot="week"></span>
          </p>
        </div>

        <p class="num">
          <span class="figure">0</span> <span class="unit">replies</span>
        </p>

        <p class="num">
          <span class="figure">1</span> <span class="unit">views</span>
        </p>

        <p class="latest">
          <span class="when">just now</span> <span class="who" data-slot="who"></span>
        </p>
      </li>
    </template>
  </div>

  <NavGroups groups={navGroups} />
</ContentLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .board {
    border: 1px solid var(--at-border);
  }

  /* Topic on the left, the counts and the last reply on the right. The four
     columns are the shape every forum index has had for twenty-five years,
     and they are the reason it reads as a forum rather than as a list of
     notices. */
  .head,
  .thread {
    display: grid;
    grid-template-columns: 1fr 4.5rem 4.5rem 9rem;
    gap: 1.1rem;
    align-items: start;
  }

  .head {
    padding: 0.55rem 1rem;
    background: var(--at-bg-alt);
    border-block-end: 1px solid var(--at-border);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--at-text-secondary);
  }

  .threads {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .thread {
    padding: 1rem;
  }

  .thread + .thread {
    border-block-start: 1px solid var(--at-border);
  }

  .thread--pinned {
    background: color-mix(in srgb, var(--at-primary) 5%, transparent);
  }

  /* A topic you started in this session. The script builds the row to the same
     shape the page renders server-side, so everything here is the difference
     and nothing else needs restating. */
  .thread--yours {
    background: color-mix(in srgb, var(--at-primary) 10%, transparent);
  }

  .thread--yours .topic h2 {
    font-size: 1.05rem;
    line-height: 1.35;
    margin: 0 0 0.3rem;
  }

  .flags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.35rem;
  }

  .pin {
    color: var(--at-primary);
  }

  .tag {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--at-border);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--at-text-secondary);
  }

  .tag--announcement,
  .tag--answered,
  .tag--yours {
    border-color: var(--at-primary);
    color: var(--at-primary);
    font-weight: 600;
  }

  .topic h2 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .topic h2 a {
    color: inherit;
  }

  .excerpt {
    margin: 0 0 0.4rem;
    font-size: 0.92rem;
    color: var(--at-text-secondary);
  }

  .started {
    margin: 0;
    font-size: 0.82rem;
    color: var(--at-text-secondary);
  }

  .num {
    margin: 0;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .head .num {
    text-align: center;
  }

  .figure {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--at-text);
  }

  .unit {
    display: block;
    font-size: 0.75rem;
    color: var(--at-text-secondary);
  }

  .latest {
    margin: 0;
    font-size: 0.82rem;
    color: var(--at-text-secondary);
  }

  .when {
    display: block;
    font-weight: 600;
    color: var(--at-text);
  }

  .who {
    display: block;
  }

  .badge {
    display: inline-block;
    white-space: nowrap;
    margin-inline-start: 0.3rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--at-primary);
    color: var(--at-primary);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .sep {
    margin-inline: 0.3rem;
  }

  /* Four columns need about 52rem before the counts start squeezing the
     titles. Under that the topic takes a full row and the three stats share
     the row beneath it.

     Named areas rather than `display: inline`, because these are grid
     children and a grid child cannot be inline: setting it gave three stats
     on three separate lines, which is a worse version of the desktop layout
     rather than a phone one. */
  @media (width < 52rem) {
    .head {
      display: none;
    }

    .thread {
      grid-template-columns: auto auto 1fr;
      grid-template-areas:
        "topic topic topic"
        "replies views latest";
      gap: 0.5rem 1rem;
      align-items: baseline;
    }

    .topic {
      grid-area: topic;
    }

    .num:first-of-type {
      grid-area: replies;
    }

    .num:nth-of-type(2) {
      grid-area: views;
    }

    .latest {
      grid-area: latest;
      text-align: end;
    }

    .num {
      text-align: start;
    }

    .figure,
    .unit,
    .when,
    .who {
      display: inline;
      font-size: 0.82rem;
      font-weight: 400;
    }

    .figure {
      font-weight: 700;
      color: var(--at-text);
    }
  }
</style>
