---
// The extension request form.
//
// It has no `action` and no `method`, and that is not squeamishness: a form
// that posts to a path this site does not serve navigates the browser to a
// 404, which is the one failure mode a student filling this in must never
// hit. The submit handler takes over, validates, and swaps the form for a
// confirmation.
//
// Everything it knows is read out of the content collections. The pieces and
// their deadlines come from the assessments; how lateness works for each one
// comes from the same frontmatter the policies table renders; the decision
// goes to whoever holds the Convenor role. Nothing here is a second copy of a
// fact that lives somewhere else on the site.
import { getPublishedCollection } from "astro-course-university/content";

interface Props {
  /** The longest extension the convenor grants directly, in days. */
  maxDays: number;
}

const { maxDays } = Astro.props;

const [assessmentEntries, people] = await Promise.all([
  getPublishedCollection("assessments"),
  getPublishedCollection("people"),
]);
const assessments = assessmentEntries.sort((a, b) => a.data.week - b.data.week);

// Who decides. Read off the people page so the form cannot route a request to
// somebody who no longer runs the course. Failing the build is the right
// answer if nobody does.
const convenorEntry = people.find((person) => person.data.role === "Convenor");
if (!convenorEntry) {
  throw new Error(
    'ExtensionRequest: no person with role "Convenor". Extension requests have nobody to go to.',
  );
}
const decider = convenorEntry.data.title;
const deciderEmail = convenorEntry.data.email ?? "";

const dueLabel = new Intl.DateTimeFormat("en-AU", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Australia/Canberra",
});

const options = assessments.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  due: entry.data.due.toISOString(),
  dueLabel: dueLabel.format(entry.data.due),
  weight: entry.data.weight,
  lateness: entry.data.lateness,
  note: entry.data.latenessNote ?? "",
}));

const reasons = [
  "Illness or injury",
  "Caring responsibilities",
  "Employment or placement clash",
  "Bereavement",
  "Field site withdrew access",
  "Other",
];
---

<section class="request" data-extension data-max-days={String(maxDays)} data-options={JSON.stringify(options)} data-decider={decider}>
  <h2 id="request-form">Extension request</h2>

  <noscript>
    <p class="fallback">
      This form needs JavaScript. Email {deciderEmail} instead, with the piece,
      the number of days and your student number.
    </p>
  </noscript>

  <form data-form novalidate>
    <p class="lede">
      Requests of up to {maxDays} days are decided by {decider} directly. Longer
      than that goes to the university's standard process, and this form will
      tell you when you have crossed the line.
    </p>

    <fieldset>
      <legend>You</legend>

      <div class="field">
        <label for="ext-name">Full name</label>
        <input id="ext-name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="row">
        <div class="field">
          <label for="ext-id">Student number</label>
          <input id="ext-id" name="student" type="text" placeholder="u1234567" required />
        </div>

        <div class="field">
          <label for="ext-email">University email</label>
          <input id="ext-email" name="email" type="email" autocomplete="email" required />
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>The request</legend>

      <div class="field">
        <label for="ext-piece">Assessment</label>
        <select id="ext-piece" name="piece" required>
          {options.map((option) => (
            <option value={option.id}>
              {option.title} ({option.weight}%)
            </option>
          ))}
        </select>
        <p class="hint" data-due></p>
      </div>

      <div class="row">
        <div class="field">
          <label for="ext-days">Days requested</label>
          <input id="ext-days" name="days" type="number" min="1" max="21" value="3" required />
        </div>

        <div class="field">
          <label for="ext-until">New due date</label>
          <output id="ext-until" class="readout" data-until></output>
        </div>
      </div>

      <div class="field">
        <label for="ext-reason">Reason</label>
        <select id="ext-reason" name="reason" required>
          {reasons.map((reason) => <option value={reason}>{reason}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="ext-detail">
          Anything you want to add <span class="optional">optional</span>
        </label>
        <textarea id="ext-detail" name="detail" rows="3"></textarea>
        <p class="hint">
          A sentence is enough. Nothing here has to be documented, and you do not
          have to explain a medical or personal matter to anybody in this course.
        </p>
      </div>
    </fieldset>

    <p class="warn" data-warn hidden></p>

    <div class="field check">
      <input id="ext-declare" name="declare" type="checkbox" required />
      <label for="ext-declare">
        The information above is accurate to the best of my knowledge.
      </label>
    </div>

    <p class="error" data-error role="alert" hidden></p>

    <div class="actions">
      <button type="submit" class="primary">Submit request</button>
    </div>
  </form>

  <div class="sent" data-sent hidden>
    <p class="tick" aria-hidden="true">&check;</p>
    <h3 tabindex="-1" data-sent-heading>Request submitted</h3>
    <p class="ref">
      Reference <strong data-ref></strong>
    </p>

    <dl class="summary">
      <dt>Assessment</dt>
      <dd data-sent-piece></dd>
      <dt>Currently due</dt>
      <dd data-sent-due></dd>
      <dt>Requested until</dt>
      <dd data-sent-until></dd>
      <dt>Reason given</dt>
      <dd data-sent-reason></dd>
      <dt>With</dt>
      <dd data-sent-decider></dd>
    </dl>

    <p data-sent-next></p>
    <p class="quiet" data-sent-copy></p>

    <div class="actions">
      <button type="button" data-again>Submit another request</button>
    </div>
  </div>
</section>

<style>
  .request {
    margin-block: 2rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--at-border);
  }

  .request h2 {
    margin-block-start: 0;
  }

  .lede {
    margin-block: 0 1.5rem;
    color: var(--at-text-secondary);
  }

  .fallback {
    padding: 0.8rem 1rem;
    border: 1px solid var(--at-primary);
    background: color-mix(in srgb, var(--at-primary) 15%, transparent);
  }

  fieldset {
    margin: 0 0 1.5rem;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-block-end: 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--at-text-secondary);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    margin-block-end: 1.1rem;
  }

  label {
    display: block;
    font-weight: 600;
    margin-block-end: 0.3rem;
  }

  .optional {
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--at-border);
    border-radius: 0;
    background: var(--at-bg);
    color: var(--at-text);
    font: inherit;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--at-primary);
    outline-offset: 1px;
  }

  [aria-invalid="true"] {
    border-color: var(--at-primary);
    border-width: 2px;
  }

  .readout {
    display: block;
    padding: 0.5rem 0.6rem;
    border: 1px dashed var(--at-border);
    color: var(--at-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
  }

  .check input {
    width: 1.05rem;
    height: 1.05rem;
    margin-block-start: 0.2rem;
  }

  .check label {
    font-weight: 400;
    margin: 0;
  }

  .hint {
    margin-block: 0.3rem 0;
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  .warn {
    margin-block: 0 1.25rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--at-primary);
    background: color-mix(in srgb, var(--at-primary) 15%, transparent);
    font-size: 0.9rem;
  }

  .error {
    margin-block: 0 1rem;
    font-weight: 600;
    color: var(--at-primary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  button {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--at-primary);
    border-radius: 0;
    background: transparent;
    color: var(--at-primary);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .primary {
    background: var(--at-primary);
    color: var(--at-bg);
  }

  button:hover {
    filter: brightness(0.93);
  }

  .tick {
    width: 2.5rem;
    height: 2.5rem;
    margin: 0 0 0.75rem;
    display: grid;
    place-items: center;
    border: 2px solid var(--at-primary);
    border-radius: 50%;
    color: var(--at-primary);
    font-size: 1.4rem;
    line-height: 1;
  }

  .sent h3 {
    margin-block: 0 0.35rem;
  }

  /* The heading takes focus after submit so a screen reader lands on the
     confirmation rather than on where the submit button used to be. It is a
     landing target with tabindex="-1", not a control, and nothing can tab to
     it, so the ring is noise: drawn around a heading it reads as a text box.
     The tick and the swapped panel are the visible feedback. */
  .sent h3:focus,
  .sent h3:focus-visible {
    outline: none;
  }

  .ref {
    margin-block: 0 1.25rem;
    color: var(--at-text-secondary);
  }

  .ref strong {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--at-text);
  }

  .summary {
    display: grid;
    grid-template-columns: minmax(8rem, auto) 1fr;
    gap: 0.35rem 1.25rem;
    margin-block: 0 1.25rem;
    padding-block: 1rem;
    border-block: 1px solid var(--at-border);
  }

  .summary dt {
    font-weight: 600;
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  .summary dd {
    margin: 0;
  }

  .quiet {
    font-size: 0.9rem;
    color: var(--at-text-secondary);
  }

  @media (width < 44rem) {
    .row,
    .summary {
      grid-template-columns: 1fr;
    }

    .summary dd {
      margin-block-end: 0.5rem;
    }
  }
</style>

<script>
  interface Option {
    id: string;
    title: string;
    due: string;
    dueLabel: string;
    weight: number;
    lateness: "standard" | "none" | "event";
    note: string;
  }

  const DAY = 86_400_000;
  const longDate = new Intl.DateTimeFormat("en-AU", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "Australia/Canberra",
  });

  for (const root of document.querySelectorAll<HTMLElement>("[data-extension]")) {
    const form = root.querySelector<HTMLFormElement>("[data-form]");
    const sent = root.querySelector<HTMLElement>("[data-sent]");
    if (!form || !sent) continue;

    const options: Option[] = JSON.parse(root.dataset.options ?? "[]");
    const maxDays = Number(root.dataset.maxDays ?? "5");
    const decider = root.dataset.decider ?? "";

    const piece = form.querySelector<HTMLSelectElement>("#ext-piece")!;
    const days = form.querySelector<HTMLInputElement>("#ext-days")!;
    const dueHint = root.querySelector<HTMLElement>("[data-due]")!;
    const until = root.querySelector<HTMLElement>("[data-until]")!;
    const warn = root.querySelector<HTMLElement>("[data-warn]")!;
    const error = root.querySelector<HTMLElement>("[data-error]")!;

    const chosen = (): Option => options.find((o) => o.id === piece.value) ?? options[0];
    const newDate = (): Date => new Date(Date.parse(chosen().due) + Number(days.value || 0) * DAY);

    const refresh = (): void => {
      const option = chosen();
      dueHint.textContent = `Currently due ${option.dueLabel} at 17:00.`;
      until.textContent = `${longDate.format(newDate())}, 17:00`;

      const notes: string[] = [];
      if (Number(days.value) > maxDays) {
        notes.push(
          `More than ${maxDays} days is beyond what ${decider} can grant directly. Submit it anyway and you will be pointed at the university's standard process rather than left to find it.`,
        );
      }
      if (option.lateness === "none") {
        notes.push(
          `${option.title} is not accepted late at all, so this has to be agreed before the deadline rather than after it.`,
        );
      }
      if (option.lateness === "event") {
        notes.push(
          `Part of ${option.title} happens in a room at a fixed time. Say below whether you are asking about the written work, the scheduled part, or both.`,
        );
      }
      if (option.note) notes.push(option.note);

      warn.hidden = notes.length === 0;
      warn.textContent = notes.join(" ");
    };

    /** Short, readable, and different every time. Nothing depends on it. */
    const reference = (): string => {
      const stamp = Date.now().toString(36).toUpperCase().slice(-4);
      const salt = Math.floor(Math.random() * 46_656)
        .toString(36)
        .toUpperCase()
        .padStart(3, "0");
      return `EXT-3068-${stamp}${salt}`;
    };

    form.addEventListener("input", refresh);
    form.addEventListener("change", refresh);

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const required = [
        ...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[required]"),
      ];
      const missing = required.filter((control) =>
        control instanceof HTMLInputElement && control.type === "checkbox"
          ? !control.checked
          : !control.value.trim(),
      );
      for (const control of required) {
        const bad = missing.includes(control);
        control.setAttribute("aria-invalid", String(bad));
      }
      if (missing.length > 0) {
        error.hidden = false;
        error.textContent =
          missing.length === 1
            ? "One field still needs filling in."
            : `${missing.length} fields still need filling in.`;
        missing[0].focus();
        return;
      }
      error.hidden = true;

      const data = new FormData(form);
      const option = chosen();
      const email = String(data.get("email") ?? "").trim();

      root.querySelector<HTMLElement>("[data-ref]")!.textContent = reference();
      root.querySelector<HTMLElement>("[data-sent-piece]")!.textContent =
        `${option.title} (${option.weight}%)`;
      root.querySelector<HTMLElement>("[data-sent-due]")!.textContent =
        `${option.dueLabel}, 17:00`;
      root.querySelector<HTMLElement>("[data-sent-until]")!.textContent =
        `${longDate.format(newDate())}, 17:00`;
      root.querySelector<HTMLElement>("[data-sent-reason]")!.textContent = String(
        data.get("reason") ?? "",
      );
      root.querySelector<HTMLElement>("[data-sent-decider]")!.textContent = decider;
      // Relative, not an absolute date. The teaching calendar is 2027 and the
      // clock on the reader's machine is not, so "a decision by <date>" put a
      // date from this year against a deadline from that one.
      root.querySelector<HTMLElement>("[data-sent-next]")!.textContent =
        `${decider} reads these the same day. Expect a decision within one working day. If it is a yes, the new date is in the reply and the reply is the record, so keep it.`;
      root.querySelector<HTMLElement>("[data-sent-copy]")!.textContent =
        `A copy has gone to ${email}. If nothing arrives within one working day, send it again rather than waiting.`;

      form.hidden = true;
      sent.hidden = false;
      // Focus the confirmation, or a screen reader stays where the submit
      // button used to be and hears nothing about what just happened.
      root.querySelector<HTMLElement>("[data-sent-heading]")!.focus();
    });

    root.querySelector<HTMLButtonElement>("[data-again]")!.addEventListener("click", () => {
      form.reset();
      for (const control of form.querySelectorAll("[aria-invalid]")) {
        control.removeAttribute("aria-invalid");
      }
      sent.hidden = true;
      form.hidden = false;
      refresh();
      form.querySelector<HTMLInputElement>("#ext-name")!.focus();
    });

    refresh();
  }
</script>
