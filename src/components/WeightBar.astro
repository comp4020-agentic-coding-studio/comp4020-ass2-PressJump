---
// The assessment weights as one bar, read straight out of the collection.
//
// A course that says its assessment adds to 100 and then lists four numbers is
// asking the reader to do the addition. This does it, and it cannot disagree
// with the assessment pages because it does not hold the numbers.
//
// The bar is decorative; every segment is also a row in the list underneath,
// which is what a screen reader and a phone get. One hue, four fills, per the
// harness rule about a second colour.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const assessments = (await getPublishedCollection("assessments")).sort(
  (a, b) => a.data.week - b.data.week,
);
const total = assessments.reduce((sum, entry) => sum + entry.data.weight, 0);

const dueDate = new Intl.DateTimeFormat("en-AU", {
  day: "numeric",
  month: "short",
  timeZone: "Australia/Canberra",
});
---

<div class="weights">
  <div class="bar" aria-hidden="true">
    {
      assessments.map((entry, index) => (
        <span
          class="segment"
          style={`flex-grow:${entry.data.weight};--fill:${18 + index * 22}%`}
          title={`${entry.data.title}, ${entry.data.weight}%`}
        >
          <span class="segment-label">{entry.data.weight}%</span>
        </span>
      ))
    }
  </div>

  <ol class="legend">
    {
      assessments.map((entry, index) => (
        <li>
          <span class="swatch" style={`--fill:${18 + index * 22}%`} aria-hidden="true" />
          <a href={withBase(`/assessments/${entry.id}/`)}>{entry.data.title}</a>
          <span class="meta">
            {entry.data.weight}% &middot; week {entry.data.week} &middot; due{" "}
            {dueDate.format(entry.data.due)}
          </span>
        </li>
      ))
    }
  </ol>

  <p class="total">
    {assessments.length} pieces, {total}% in total.
  </p>
</div>

<style>
  .weights {
    margin-block: 1.5rem 2rem;
  }

  .bar {
    display: flex;
    width: 100%;
    height: 2.25rem;
    border: 1px solid var(--at-primary);
    overflow: hidden;
  }

  .segment {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    background: color-mix(in srgb, var(--at-primary) var(--fill), transparent);
  }

  .segment + .segment {
    border-inline-start: 1px solid var(--at-primary);
  }

  .segment-label {
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .legend {
    list-style: none;
    margin-block: 1rem 0;
    padding: 0;
  }

  .legend li {
    display: grid;
    grid-template-columns: 0.85rem 1fr;
    gap: 0.15rem 0.6rem;
    align-items: baseline;
    padding-block: 0.4rem;
    border-block-end: 1px solid var(--at-border);
  }

  .swatch {
    grid-row: span 2;
    width: 0.85rem;
    height: 0.85rem;
    border: 1px solid var(--at-primary);
    background: color-mix(in srgb, var(--at-primary) var(--fill), transparent);
  }

  .meta {
    font-size: 0.85rem;
    color: var(--at-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .total {
    margin-block-start: 0.9rem;
    font-size: 0.9rem;
    color: var(--at-text-secondary);
  }
</style>
